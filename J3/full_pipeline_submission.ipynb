{
    "cells": [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# Full Pipeline Submission with LightGBM & Optuna\n",
                "\n",
                "This notebook executes the complete feature engineering pipeline on the **full dataset**, optimizes a LightGBM model using Optuna, and generates a submission file."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import pandas as pd\n",
                "import numpy as np\n",
                "import mlflow\n",
                "import sys\n",
                "import os\n",
                "import lightgbm as lgb\n",
                "import optuna\n",
                "from sklearn.model_selection import StratifiedKFold, cross_val_score\n",
                "from sklearn.metrics import accuracy_score\n",
                "\n",
                "# Add pipeline directory to path\n",
                "sys.path.append(os.path.abspath('.'))\n",
                "\n",
                "from pipeline.feature_engineering import (\n",
                "    RawFeatureGenerator,\n",
                "    RollingStatFeatureGenerator,\n",
                "    GroupedFeatureGenerator,\n",
                "    MomentumGenerator,\n",
                "    VolatilityRatioGenerator,\n",
                "    InteractionGenerator,\n",
                "    ShortTermInteractionGenerator\n",
                ")\n",
                "from pipeline.feature_selection import FeatureEvaluator\n",
                "\n",
                "# Set MLflow experiment\n",
                "mlflow.set_experiment(\"QRT_Full_Submission_Optuna\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 1. Load Full Data\n",
                "Loading `X_train.csv`, `y_train.csv`, and `X_test.csv`."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "print(\"Loading Data...\")\n",
                "X_train_full = pd.read_csv('Data/X_train.csv')\n",
                "y_train_full = pd.read_csv('Data/y_train.csv')\n",
                "X_test_full = pd.read_csv('Data/X_test.csv')\n",
                "\n",
                "# Preprocess Y\n",
                "# Target is return, check if binary classification is needed\n",
                "# For this challenge, typically we predict the sign or probability of return > 0\n",
                "# Merging X and Y for training data\n",
                "train_df = X_train_full.merge(y_train_full, on='ROW_ID')\n",
                "y = (train_df['target'] > 0).astype(int) # Binary target\n",
                "X = train_df.drop(columns=['target', 'ROW_ID'])\n",
                "\n",
                "# Test Data (No Target)\n",
                "X_test = X_test_full.drop(columns=['ROW_ID'])\n",
                "\n",
                "print(f\"Training Data: {X.shape}\")\n",
                "print(f\"Test Data: {X_test.shape}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 2. Feature Engineering Pipeline\n",
                "Applying the best generators found during experimentation."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "lag_features = [f'RET_{i}' for i in range(1, 21)]\n",
                "volume_features = [f'SIGNED_VOLUME_{i}' for i in range(1, 21)]\n",
                "\n",
                "generators = [\n",
                "    # 1. Raw Lags\n",
                "    RawFeatureGenerator(cols=lag_features + volume_features + ['MEDIAN_DAILY_TURNOVER']),\n",
                "    \n",
                "    # 2. Rolling Stats\n",
                "    RollingStatFeatureGenerator(cols=lag_features, windows=[5, 10, 20], operations=['mean', 'std', 'min', 'max']),\n",
                "    \n",
                "    # 3. Momentum\n",
                "    MomentumGenerator(windows=[(5, 20), (1, 5), (1, 20)]),\n",
                "\n",
                "    # 4. Volatility Ratio\n",
                "    VolatilityRatioGenerator(windows=[(5, 20)]),\n",
                "\n",
                "    # 5. Grouped Stats\n",
                "    GroupedFeatureGenerator(group_col='GROUP', target_cols=['RET_1', 'SIGNED_VOLUME_1'], operations=['mean']),\n""    \n",
                "    # 6. Short Term Interactions\n",
                "    ShortTermInteractionGenerator(max_lag=10)\n",
                "]\n",
                "\n",
                "print(\"Generating Features for Training Set...\")\n",
                "X_transformed = pd.DataFrame(index=X.index)\n",
                "for gen in generators:\n",
                "    gen.fit(X, y)\n",
                "    X_part = gen.transform(X)\n",
                "    X_transformed = pd.concat([X_transformed, X_part], axis=1)\n",
                "X_transformed = X_transformed.fillna(0)\n",
                "\n",
                "print(\"Generating Features for Test Set...\")\n",
                "X_test_transformed = pd.DataFrame(index=X_test.index)\n",
                "for gen in generators:\n",
                "    # Note: Generators are already fitted on Train, so we just transform Test\n",
                "    # Be careful with GroupedFeatureGenerator: it uses stats from fit() (train data) which is correct to avoid leakage\n",
                "    X_part = gen.transform(X_test)\n",
                "    X_test_transformed = pd.concat([X_test_transformed, X_part], axis=1)\n",
                "X_test_transformed = X_test_transformed.fillna(0)\n",
                "\n",
                "print(f\"Generated Features: {X_transformed.shape[1]}\")"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Drop highly correlated features based on Training Set\n",
                "evaluator = FeatureEvaluator(cv=3)\n",
                "high_corr_features = evaluator.check_correlation(X_transformed, threshold=0.98) # Slightly higher threshold for LGBM\n",
                "print(f\"Dropping {len(high_corr_features)} highly correlated features.\")\n",
                "\n",
                "X_final = X_transformed.drop(columns=high_corr_features)\n",
                "X_test_final = X_test_transformed.drop(columns=high_corr_features)\n",
                "\n",
                "print(f\"Final Feature Count: {X_final.shape[1]}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 3. Optuna Optimization (LightGBM)\n",
                "Finding the best hyperparameters."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "def objective(trial):\n",
                "    param = {\n",
                "        'objective': 'binary',\n",
                "        'metric': 'binary_error', # maximize accuracy\n",
                "        'verbosity': -1,\n",
                "        'boosting_type': 'gbdt',\n",
                "        'n_estimators': trial.suggest_int('n_estimators', 100, 500),\n",
                "        'learning_rate': trial.suggest_float('learning_rate', 1e-3, 0.1, log=True),\n",
                "        'num_leaves': trial.suggest_int('num_leaves', 20, 150),\n",
                "        'max_depth': trial.suggest_int('max_depth', -1, 12),\n",
                "        'min_child_samples': trial.suggest_int('min_child_samples', 5, 100),\n",
                "        'subsample': trial.suggest_float('subsample', 0.5, 1.0),\n",
                "        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.5, 1.0),\n",
                "    }\n",
                "\n",
                "    # 3-Fold Stratified CV for speed in optimization\n",
                "    folds = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)\n",
                "    scores = []\n",
                "    \n",
                "    # Use a smaller subset for faster optimization if dataset is huge, \n",
                "    # but here we run on full train for robustness\n",
                "    # LGBM Dataset format\n",
                "    # To speed up, we can use sklearn API directly\n",
                "    clf = lgb.LGBMClassifier(**param, random_state=42, n_jobs=-1)\n",
                "    \n",
                "    # Using cross_val_score\n",
                "    cv_scores = cross_val_score(clf, X_final, y, cv=folds, scoring='accuracy')\n",
                "    return cv_scores.mean()\n",
                "\n",
                "print(\"Starting Optuna Optimization...\")\n",
                "study = optuna.create_study(direction='maximize')\n",
                "study.optimize(objective, n_trials=30) # Adjust trials as needed\n",
                "\n",
                "print(\"Best trial:\")\n",
                "trial = study.best_trial\n",
                "print(f\"  Value: {trial.value}\")\n",
                "print(\"  Params: \")\n",
                "for key, value in trial.params.items():\n",
                "    print(f\"    {key}: {value}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 4. Retrain & Submit\n",
                "Retraining on the full training set with best parameters and predicting on the test set."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "best_params = study.best_params\n",
                "# Ensure static params are included\n",
                "best_params['objective'] = 'binary'\n",
                "best_params['metric'] = 'binary_error'\n",
                "best_params['verbosity'] = -1\n",
                "best_params['boosting_type'] = 'gbdt'\n",
                "\n",
                "print(\"Retraining best model on full data...\")\n",
                "final_model = lgb.LGBMClassifier(**best_params, random_state=42, n_jobs=-1)\n",
                "final_model.fit(X_final, y)\n",
                "\n",
                "print(\"Predicting on Test Set...\")\n",
                "probs = final_model.predict_proba(X_test_final)[:, 1]\n",
                "\n",
                "# Prepare Submission\n",
                "submission = pd.DataFrame()\n",
                "submission['ROW_ID'] = X_test_full['ROW_ID']\n",
                "submission['score'] = probs\n",
                "\n",
                "submission_path = 'submission_lgbm_optuna.csv'\n",
                "submission.to_csv(submission_path, index=False)\n",
                "print(f\"Submission saved to {submission_path}\")"
            ]
        }
    ],
